{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "websearch": {
    "provider": "exa",
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
  ],
}
