{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "websearch": {
    "provider": "exa",
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
        },
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": [
          "/Users/saurabh/.bun/bin/bunx",
          "--bun",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--browser",
          "chromium",
          "--caps=vision"
        ],
        "disabled": true,
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "/Users/saurabh/.bun/bin/bunx",
          "--bun",
          "chrome-devtools-mcp@latest",
          "--isolated",
        ],
      },
    },
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask",
    },
  ],
}
