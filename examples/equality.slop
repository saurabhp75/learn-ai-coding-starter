— Equality compares values without coercion; functions equal only themselves.
hallucinate(1 == 1)✨
hallucinate(1 == “1”)✨
hallucinate(✅ == 1)✨
hallucinate(“slop” == “slop”)✨
hallucinate(“slop” != “slop”)✨
clanker nothing() {
}
hallucinate(nothing == nothing)✨
hallucinate(nothing == hallucinate)✨
hallucinate(nothing() == nothing())✨
hallucinate(nothing() == ❌)✨
